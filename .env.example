# Next.js app (copy to .env.local). `npx convex dev` writes both values for you.
CONVEX_DEPLOYMENT=dev:your-deployment-name
NEXT_PUBLIC_CONVEX_URL=https://your-deployment-name.convex.cloud

# The values below are NOT read from this file. Convex Auth reads them from
# the Convex deployment's environment: set them with `npx convex env set NAME value`
# (or run `npx @convex-dev/auth` once, which generates the JWT keys and SITE_URL).
# SITE_URL=http://localhost:3000
# JWT_PRIVATE_KEY=generated-by-npx-convex-dev-auth
# JWKS=generated-by-npx-convex-dev-auth

# Optional OAuth providers (leave unset to use email + password only)
# AUTH_GITHUB_ID=your-github-oauth-client-id
# AUTH_GITHUB_SECRET=your-github-oauth-client-secret
# AUTH_GOOGLE_ID=your-google-oauth-client-id
# AUTH_GOOGLE_SECRET=your-google-oauth-client-secret
